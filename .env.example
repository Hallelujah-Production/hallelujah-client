# NestJS API origin only — no trailing slash and no /api/v1.
# The BFF appends /api/v1. If the origin already includes it, requests double.
# Local: http://localhost:3001
# Production: https://<render-api>.onrender.com
# Permanent public app URL is https://<project>.vercel.app (no custom .com).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional server-only override (same value locally). Never put credentials here.
API_URL=http://localhost:3001

# Server-only. Must match server SETUP_SECRET. Never NEXT_PUBLIC_SETUP_SECRET.
SETUP_SECRET=

# Never put SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, or the storage bucket
# secret here. Payment proofs are uploaded through the Nest API.
